{
  "name": "config-agent-kit",
  "version": "1.4.1",
  "author": "FriendlyNGeeks",
  "license": "MIT",
  "description": "Configure coding-agent instructions and skills, with guided native project scaffolding",
  "type": "module",
  "bin": {
    "config-agent-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
